# Переменные для Vercel (Settings → Environment Variables). Реальные значения не коммитить.

# Способ записи: google-sheets (личный Gmail), power-automate (рабочий Microsoft 365) или graph
EXCEL_DRIVER=google-sheets

# --- Google Таблица (docs/GOOGLE_SHEETS_SETUP.md) ---
GOOGLE_SCRIPT_URL=

# --- Power Automate (docs/EXCEL_SETUP.md) ---
POWER_AUTOMATE_URL=

# Общее секретное слово (то же, что в скрипте Google или в потоке Power Automate)
RSVP_SHARED_SECRET=

RSVP_TIMEZONE=Europe/Moscow
RSVP_MAX_PEOPLE=30
